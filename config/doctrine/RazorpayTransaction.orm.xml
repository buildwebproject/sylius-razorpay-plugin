<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="BuildWebProject\SyliusRazorpayPlugin\Entity\RazorpayTransaction" table="bwp_razorpay_transaction">
        <indexes>
            <index name="bwp_razorpay_tx_status" columns="status,updated_at"/>
        </indexes>
        <id name="id" type="integer"><generator strategy="AUTO"/></id>
        <field name="receipt" type="string" length="40" unique="true"/>
        <field name="amount" type="integer"/>
        <field name="currencyCode" column="currency_code" type="string" length="3"/>
        <field name="accountFingerprint" column="account_fingerprint" type="string" length="64"/>
        <field name="razorpayOrderId" column="razorpay_order_id" type="string" length="64" nullable="true" unique="true"/>
        <field name="razorpayPaymentId" column="razorpay_payment_id" type="string" length="64" nullable="true"/>
        <field name="status" type="string" length="20"/>
        <field name="reviewReason" column="review_reason" type="string" length="255" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <one-to-one field="payment" target-entity="Sylius\Component\Core\Model\PaymentInterface">
            <join-column name="payment_id" referenced-column-name="id" nullable="false" unique="true"/>
        </one-to-one>
    </entity>
</doctrine-mapping>

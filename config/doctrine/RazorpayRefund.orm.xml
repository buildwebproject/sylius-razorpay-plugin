<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="BuildWebProject\SyliusRazorpayPlugin\Entity\RazorpayRefund" table="bwp_razorpay_refund">
        <indexes>
            <index name="bwp_razorpay_refund_status" columns="status,updated_at"/>
        </indexes>
        <id name="id" type="integer"><generator strategy="AUTO"/></id>
        <field name="refundPaymentId" column="refund_payment_id" type="integer" unique="true"/>
        <field name="amount" type="integer"/>
        <field name="currencyCode" column="currency_code" type="string" length="3"/>
        <field name="razorpayRefundId" column="razorpay_refund_id" type="string" length="64" nullable="true" unique="true"/>
        <field name="status" type="string" length="20"/>
        <field name="failureReason" column="failure_reason" type="string" length="255" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <many-to-one field="transaction" target-entity="BuildWebProject\SyliusRazorpayPlugin\Entity\RazorpayTransaction">
            <join-column name="transaction_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
